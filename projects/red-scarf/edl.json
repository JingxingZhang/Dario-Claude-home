  "shots": [
    {"id": "S01", "start": 0.0,    "end": 2.476,  "in": 0.0, "note": "建立镜头：大风海边坡城，她走入画面，围巾横飘"},
    {"id": "S02", "start": 2.476,  "end": 4.666,  "in": 0.0, "note": "气球脱手，围巾末端卷住绳子还给小孩"},
    {"id": "S03", "start": 4.666,  "end": 6.848,  "in": 0.0, "note": "报纸被吹散，围巾一扫叠回老人手里"},
    {"id": "S04", "start": 6.848,  "end": 9.031,  "in": 0.0, "note": "擦窗工梯子歪倒，围巾把梯子绑在路灯上"},
    {"id": "S05", "start": 9.031,  "end": 11.215, "in": 0.0, "note": "鸟窝坠落，围巾当吊床接住"},
    {"id": "S06", "start": 11.215, "end": 13.399, "in": 0.0, "note": "咖啡馆服务生托盘倾斜，围巾垫成托盘"},
    {"id": "S07", "start": 13.399, "end": 15.583, "in": 0.0, "note": "风筝挂树上，她甩围巾像套索去勾"},
    {"id": "S08", "start": 15.583, "end": 17.762, "in": 0.0, "note": "风筝挣脱飞走，把围巾也带上天；她仰头，脖子空了"},
    {"id": "S09", "start": 17.762, "end": 19.940, "in": 0.0, "note": "她继续走，风停了，落叶缓缓落地"},
    {"id": "S10", "start": 19.940, "end": 22.120, "in": 0.0, "note": "大特写：一片雪花落在她鼻尖（音乐 21.36s 换段）"},
    {"id": "S11", "start": 22.120, "end": 24.302, "in": 0.0, "note": "脸部特写：面无表情，轻轻一抖，呼出白气"},
    {"id": "S12", "start": 24.302, "end": 27.578, "in": 0.0, "note": "红围巾从天上飘落，正好绕回她脖子；远处小孩拿着风筝挥手"},
    {"id": "S13", "start": 27.578, "end": 30.0,   "in": 0.0, "note": "背影走进初雪，围巾飘动，渐白"}
  ]

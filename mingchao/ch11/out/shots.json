 "song": {
  "duration": 179.605,
  "lines": [
   {
    "start": 12.513,
    "end": 16.442,
    "text": "你守着八个城门　朱文正",
    "chorus": false,
    "tag": "Verse 1"
   },
   {
    "start": 18.307,
    "end": 20.982,
    "text": "一三六三年　四月水涨",
    "chorus": false,
    "tag": "Verse 1"
   },
   {
    "start": 24.192,
    "end": 26.529,
    "text": "江上来了　三层的大船",
    "chorus": false,
    "tag": "Verse 1"
   },
   {
    "start": 26.972,
    "end": 29.479,
    "text": "橹箱裹着铁　船身刷着红漆",
    "chorus": false,
    "tag": "Verse 1"
   },
   {
    "start": 29.746,
    "end": 32.445,
    "text": "号称六十万　连家眷都带来了",
    "chorus": false,
    "tag": "Verse 1"
   },
   {
    "start": 32.652,
    "end": 35.704,
    "text": "手里留两千人　哪个门破去哪个",
    "chorus": false,
    "tag": "Verse 1"
   },
   {
    "start": 35.661,
    "end": 39.884,
    "text": "城门关着　城门关着",
    "chorus": true,
    "tag": "Refrain"
   },
   {
    "start": 40.457,
    "end": 44.526,
    "text": "墙塌了　天亮前又砌上",
    "chorus": true,
    "tag": "Refrain"
   },
   {
    "start": 47.853,
    "end": 49.864,
    "text": "抚州门外　竹盾像簸箕",
    "chorus": false,
    "tag": "Verse 2"
   },
   {
    "start": 49.839,
    "end": 52.744,
    "text": "墙塌了二十多丈　邓愈点了火铳",
    "chorus": false,
    "tag": "Verse 2"
   },
   {
    "start": 53.018,
    "end": 55.876,
    "text": "新城门　薛显自己打开了门",
    "chorus": false,
    "tag": "Verse 2"
   },
   {
    "start": 56.074,
    "end": 58.782,
    "text": "带着人冲出去　砍了对面的平章",
    "chorus": false,
    "tag": "Verse 2"
   },
   {
    "start": 58.965,
    "end": 61.746,
    "text": "水关里伸出长槊　有人伸手去抢",
    "chorus": false,
    "tag": "Verse 2"
   },
   {
    "start": 62.077,
    "end": 64.59,
    "text": "第二回　铁钩是烧红的",
    "chorus": false,
    "tag": "Verse 2"
   },
   {
    "start": 64.979,
    "end": 67.705,
    "text": "宫步门上　赵德胜中了一箭",
    "chorus": false,
    "tag": "Verse 2"
   },
   {
    "start": 68.14,
    "end": 70.669,
    "text": "箭进去六寸　他说这是命",
    "chorus": false,
    "tag": "Verse 2"
   },
   {
    "start": 71.331,
    "end": 75.766,
    "text": "城门关着　城门关着",
    "chorus": true,
    "tag": "Refrain"
   },
   {
    "start": 75.717,
    "end": 80.053,
    "text": "墙塌了　天亮前又砌上",
    "chorus": true,
    "tag": "Refrain"
   },
   {
    "start": 83.177,
    "end": 87.423,
    "text": "城门关着　城门关着",
    "chorus": true,
    "tag": "Refrain"
   },
   {
    "start": 93.934,
    "end": 96.441,
    "text": "今天夜里　也有人在路上",
    "chorus": false,
    "tag": "Bridge"
   },
   {
    "start": 96.989,
    "end": 99.574,
    "text": "电动车的灯　穿过高架桥",
    "chorus": false,
    "tag": "Bridge"
   },
   {
    "start": 99.897,
    "end": 102.608,
    "text": "手机里有人问　到哪儿了",
    "chorus": false,
    "tag": "Bridge"
   },
   {
    "start": 102.858,
    "end": 105.582,
    "text": "他说马上就到　马上就到",
    "chorus": false,
    "tag": "Bridge"
   },
   {
    "start": 105.967,
    "end": 108.693,
    "text": "一条打鱼的小船　从水关出去",
    "chorus": false,
    "tag": "Verse 3"
   },
   {
    "start": 108.845,
    "end": 111.606,
    "text": "张子明夜里赶路　白天躲着",
    "chorus": false,
    "tag": "Verse 3"
   },
   {
    "start": 112.254,
    "end": 114.615,
    "text": "走了半个月　才走到应天",
    "chorus": false,
    "tag": "Verse 3"
   },
   {
    "start": 114.785,
    "end": 117.301,
    "text": "回去告诉文正　再守一个月",
    "chorus": false,
    "tag": "Verse 3"
   },
   {
    "start": 118.945,
    "end": 121.877,
    "text": "走到湖口　他被抓住了",
    "chorus": false,
    "tag": "Verse 3"
   },
   {
    "start": 121.991,
    "end": 124.049,
    "text": "押到城下　让他喊一声投降",
    "chorus": false,
    "tag": "Verse 3"
   },
   {
    "start": 124.575,
    "end": 127.421,
    "text": "他喊的是守住　救兵就要到了",
    "chorus": false,
    "tag": "Verse 3"
   },
   {
    "start": 127.88,
    "end": 130.297,
    "text": "长槊一起落下　在城墙底下",
    "chorus": false,
    "tag": "Verse 3"
   },
   {
    "start": 130.929,
    "end": 135.078,
    "text": "城门开着　城门开着",
    "chorus": true,
    "tag": "Final Refrain"
   },
   {
    "start": 135.315,
    "end": 136.774,
    "text": "一座城　守了八十五天",
    "chorus": true,
    "tag": "Final Refrain"
   },
   {
    "start": 136.99,
    "end": 139.589,
    "text": "城门开着　城门开着",
    "chorus": true,
    "tag": "Final Refrain"
   },
   {
    "start": 139.911,
    "end": 142.435,
    "text": "喊话的那个人　没有进来",
    "chorus": true,
    "tag": "Final Refrain"
   }
  ],
